<?xml version="1.0" encoding="utf-8"?>
<!-- v5: white glass pulse instead of the old mint-green ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:width="42dp" android:height="42dp" android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="2.5dp" android:color="#B3FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
